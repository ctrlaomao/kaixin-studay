.math-stem {
  display: block;
}
.p {
  display: block;
  font-size: 30rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}
.tbl {
  margin: 12rpx 0;
  border: 1rpx solid #d6d3d1;
  border-radius: 8rpx;
  overflow: hidden;
}
.tr {
  display: flex;
  border-bottom: 1rpx solid #e7e5e4;
}
.tr:last-child {
  border-bottom: none;
}
.td {
  flex: 1;
  padding: 8rpx 10rpx;
  font-size: 26rpx;
  border-right: 1rpx solid #e7e5e4;
  word-break: break-all;
}
.td:last-child {
  border-right: none;
}
.note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8a29e;
}
