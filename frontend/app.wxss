page {
  background: #f4f1ea;
  color: #1c1917;
  font-size: 28rpx;
  min-height: 100%;
}
.wrap { padding: 24rpx; }
.h1 { font-size: 40rpx; font-weight: 700; color: #0f766e; margin-bottom: 8rpx; }
.muted { color: #78716c; font-size: 24rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}
.btn {
  margin-top: 16rpx;
  background: #0f766e;
  color: #fff;
  border-radius: 12rpx;
}
.btn-warn { background: #d97706; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
