<view class="wrap">
  <view class="h1">拍照检查</view>
  <view class="muted">每次拍照一条记录。识别完成后可点进去看详情。</view>
  <button class="btn shoot" bindtap="shoot" loading="{{busy}}">拍照检查</button>
  <view class="muted err" wx:if="{{msg}}">{{msg}}</view>
  <view class="h2">检查记录</view>
  <view class="card rec" wx:for="{{records}}" wx:key="id" bindtap="openRecord" data-index="{{index}}">
    <view class="row">
      <text>{{item.title}}</text>
      <text class="st st-{{item.jobStatus}}">{{item.statusText}}</text>
    </view>
    <view class="muted">{{item.sub}}</view>
  </view>
  <view class="muted" wx:if="{{!records.length}}">还没有拍照记录。</view>
</view>
